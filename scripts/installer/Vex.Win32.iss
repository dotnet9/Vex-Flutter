// Native drawing declarations adapted from Vex, MIT. See VEX-LICENSE.txt.
type
  TVPoint = record X, Y: Integer; end;
  TVRect = record Left, Top, Right, Bottom: Integer; end;
  TVCharFormat = array[0..22] of LongWord;
  TVPaint = record
    DC: LongWord; Erase: LongBool; Bounds: TVRect;
    Restore, Update: LongBool; Reserved: array[0..31] of Byte;
  end;
  TVDrawItem = record
    CtlType, CtlID, ItemID, ItemAction, ItemState: LongWord;
    ItemWindow, DC: LongWord;
    Bounds: TVRect;
    ItemData: LongWord;
  end;
function TWBitBlt(Target: LongWord; X,Y,Width,Height: Integer; Source: LongWord; SourceX,SourceY: Integer; Mode: LongWord): Boolean;
  external 'BitBlt@gdi32.dll stdcall';
function TWTempFile(Directory,Prefix: String; Unique: Cardinal; Buffer: String): Cardinal;
  external 'GetTempFileNameW@kernel32.dll stdcall';
type
  TWMessage = record Window,Message,WParam,LParam,Time: LongWord; Point: TVPoint; end;
function TWPeekMessage(var Message: TWMessage; Window,First,Last,Flags: LongWord): Boolean;
  external 'PeekMessageW@user32.dll stdcall';
function TWDialogMessage(Window: LongWord; var Message: TWMessage): Boolean;
  external 'IsDialogMessageW@user32.dll stdcall';
function TWTranslateMessage(var Message: TWMessage): Boolean;
  external 'TranslateMessage@user32.dll stdcall';
function TWDispatchMessage(var Message: TWMessage): Longint;
  external 'DispatchMessageW@user32.dll stdcall';
function TWWaitMessage: Boolean;
  external 'WaitMessage@user32.dll stdcall';
function VPolygon(var Points: TVPoint; Count, Mode: Integer): LongWord;
  external 'CreatePolygonRgn@gdi32.dll stdcall';
